Package: rmoriedata
Type: Package
Title: Disclosure Control for Aggregate Releases, with Open Datasets
Version: 0.4.3
Authors@R: c(
  person(
    given = c("Vansh", "Singh"),
    family = "Ruhela",
    email = "vsruhela@proton.me",
    role = c("aut", "cre"),
    comment = c(ORCID = "0009-0004-1750-3592")
  )
